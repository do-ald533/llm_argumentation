# OpenAI API Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# DeepSeek API Configuration (optional alternative)
# DEEPSEEK_API_KEY=your-deepseek-api-key-here
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Pipeline Configuration
MAX_RETRIES=3
TIMEOUT_SECONDS=120
TEMPERATURE=0.0

# Data Paths
INPUT_DATA_DIR=data/Input
OUTPUT_DATA_DIR=output
GOLDEN_STANDARD_DIR=data/Golden Standard

# MLflow Experiment Tracking
ENABLE_MLFLOW=true
MLFLOW_TRACKING_URI=./mlruns
MLFLOW_EXPERIMENT_NAME=argumentation-structuring
PROMPT_VERSION=1.0

# Notes:
# - TEMPERATURE=0.0 for deterministic outputs
# - Set ENABLE_MLFLOW=false to disable experiment tracking
# - Update PROMPT_VERSION when you modify prompts in src/llm/prompts.py

